# Frontend financeiro
VITE_SUPABASE_URL=https://fowqidmmseynoneekrse.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_FINANCEIRA
VITE_APP_NAME=STEP Finance Control
VITE_REQUIRE_PASSKEY=false

# Integração com a Intranet STEP
# Em produção deve permanecer true: o usuário entra pela sessão corporativa, sem repetir senha.
VITE_INTRANET_INTEGRATION=true
VITE_ALLOW_STANDALONE_LOGIN=false
VITE_FINANCE_BOOTSTRAP_URL=/api/finance/session/bootstrap
VITE_FINANCE_LOGOUT_URL=/api/finance/session/logout
VITE_INTRANET_HOME_URL=/intranet

# Supabase Edge Functions / WebAuthn
# Configure somente no backend/Secrets do Supabase. Nunca exponha SERVICE_ROLE no navegador.
SUPABASE_URL=https://fowqidmmseynoneekrse.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY_FINANCEIRA
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_APENAS_NO_BACKEND
WEBAUTHN_RP_NAME=STEP Finance Control
WEBAUTHN_RP_ID=intranet-step.netlify.app
WEBAUTHN_ORIGIN=https://intranet-step.netlify.app
